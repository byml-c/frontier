# Keep the app bound to localhost when it is exposed with Tailscale Serve.
FRONTIER_HOST=127.0.0.1
FRONTIER_PORT=8000
FRONTIER_TIMEZONE=Asia/Shanghai
FRONTIER_DATA_DIR=/opt/frontier/data

# Codex provider/model credentials stay in the Unix user's Codex configuration.
FRONTIER_CODEX_COMMAND=codex
# Optional Codex profile file name, for example $CODEX_HOME/research.config.toml.
# Leave unset to use the default Codex configuration.
# FRONTIER_CODEX_PROFILE=research
# Optional shared outbound proxy for Agent providers, translation, arXiv, and paper downloads.
# FRONTIER_OUTBOUND_PROXY=http://127.0.0.1:7890
FRONTIER_CODEX_SANDBOX=workspace-write
# Allow the sandboxed Agent to reach Frontier Server and paper sources.
FRONTIER_CODEX_NETWORK_ACCESS=true
# Keep a small fixed pool of warm App Server processes. Each worker can retain
# multiple conversation threads and executes one turn at a time.
FRONTIER_CODEX_APP_SERVER_MAX_WORKERS=1
# One spawned subagent at a time, with no nested delegation. Values are passed
# as invocation-level Codex overrides so a user profile cannot relax them.
FRONTIER_CODEX_MAX_CONCURRENT_SUBAGENTS=1
FRONTIER_CODEX_SUBAGENT_MAX_DEPTH=1
FRONTIER_CODEX_SUBAGENT_JOB_TIMEOUT_SECONDS=1800

# Total root Codex budget: 4 general + 2 metadata workers.
FRONTIER_AGENT_MAX_CONCURRENT_RUNS=6
FRONTIER_METADATA_AGENT_MAX_CONCURRENT_RUNS=2
FRONTIER_AGENT_TASK_TIMEOUT_SECONDS=10800
FRONTIER_AGENT_INTERACTIVE_TIMEOUT_SECONDS=3600
FRONTIER_AGENT_APP_SERVER_START_TIMEOUT_SECONDS=30
FRONTIER_AGENT_TIMEOUT_GRACE_SECONDS=10

# Production requires the system unit's delegated cgroup v2 controllers. If
# setup fails, Web remains available but Agent launches fail instead of running
# without isolation.
FRONTIER_AGENT_CGROUP_MODE=required
# Optional test/custom mount override; normally discovered from /proc/self/cgroup.
# FRONTIER_AGENT_CGROUP_ROOT=/sys/fs/cgroup/system.slice/frontier.service

# Web/server leaf: 256 MiB soft, 384 MiB hard, 50% of one CPU.
FRONTIER_AGENT_SERVER_MEMORY_HIGH_BYTES=268435456
FRONTIER_AGENT_SERVER_MEMORY_MAX_BYTES=402653184
FRONTIER_AGENT_SERVER_MEMORY_SWAP_MAX_BYTES=67108864
FRONTIER_AGENT_SERVER_CPU_QUOTA_PERCENT=50
FRONTIER_AGENT_SERVER_TASKS_MAX=96

# Aggregate Agent subtree: 640 MiB soft, 768 MiB hard, one CPU.
FRONTIER_AGENT_POOL_MEMORY_HIGH_BYTES=671088640
FRONTIER_AGENT_POOL_MEMORY_MAX_BYTES=805306368
FRONTIER_AGENT_POOL_MEMORY_SWAP_MAX_BYTES=0
FRONTIER_AGENT_POOL_CPU_QUOTA_PERCENT=100
FRONTIER_AGENT_POOL_TASKS_MAX=128

# Per Codex process tree. The aggregate pool remains the final shared cap.
FRONTIER_AGENT_MEMORY_HIGH_BYTES=536870912
FRONTIER_AGENT_MEMORY_MAX_BYTES=671088640
FRONTIER_AGENT_MEMORY_SWAP_MAX_BYTES=0
FRONTIER_AGENT_CPU_QUOTA_PERCENT=100
FRONTIER_AGENT_IO_WEIGHT=25
# Hard limits for the filesystem containing FRONTIER_DATA_DIR. Frontier derives
# its cgroup major:minor device automatically at startup.
FRONTIER_AGENT_IO_READ_BPS=20971520
FRONTIER_AGENT_IO_WRITE_BPS=10485760
FRONTIER_AGENT_TASKS_MAX=96
# PDF/full-text work is serialized; extraction uses a supervised child process.
FRONTIER_PAPER_PROCESSING_MAX_CONCURRENCY=1
FRONTIER_PAPER_DOWNLOAD_MAX_BYTES=67108864
FRONTIER_PAPER_TEXT_MAX_CHARS=20000000
FRONTIER_DOCUMENT_RUNTIME_SLOTS=5
FRONTIER_DOCUMENT_RUNTIME_IDLE_SECONDS=900
FRONTIER_STORAGE_MIGRATION_MODE=auto
FRONTIER_ENABLE_SCHEDULER=true
FRONTIER_ENABLE_CODEX_RUNS=true
# Low-memory deployments should keep this off. Text mode will use arXiv HTML only.
FRONTIER_ENABLE_DOCLING=false
FRONTIER_API_BASE_URL=http://127.0.0.1:8000

# Public sharing is limited to /daily. Other Web pages and APIs require this
# password once per device; successful verification creates a persistent
# HttpOnly trusted-device cookie.
FRONTIER_ACCESS_PASSWORD=byml-frontier
# Optional: set a separate high-entropy token for the local Frontier CLI/Agent.
# If omitted, a deterministic token is derived from the access password.
# FRONTIER_INTERNAL_API_TOKEN=replace-with-a-long-random-secret
# Enable only when the public site is served through HTTPS.
FRONTIER_TRUSTED_COOKIE_SECURE=false

# Translation credentials live in a separate file; copy translation.env.example
# to translation.env and fill OPENAI_API_KEY, BASE_URL, and MODEL there.
# FRONTIER_TRANSLATION_ENV_FILE=/opt/frontier/translation.env
FRONTIER_TRANSLATION_TIMEOUT_SECONDS=120

# Alibaba Cloud Model Studio non-streaming Qwen3-TTS (China/Beijing region).
# The API key must belong to the same region as the endpoint.
FRONTIER_ALIYUN_TTS_API_KEY=
FRONTIER_ALIYUN_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
FRONTIER_ALIYUN_TTS_MODEL=qwen3-tts-instruct-flash
FRONTIER_ALIYUN_TTS_VOICE=Cherry
FRONTIER_ALIYUN_TTS_INSTRUCTIONS=请用自然、清晰、克制的中文播客旁白语气朗读。
FRONTIER_ALIYUN_TTS_TIMEOUT_SECONDS=120
FRONTIER_ALIYUN_TTS_MAX_RETRIES=2
FRONTIER_ALIYUN_TTS_CHUNK_MAX_CHARS=500
FRONTIER_ALIYUN_TTS_AUDIO_MAX_BYTES=33554432
